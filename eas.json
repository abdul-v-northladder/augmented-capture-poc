{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ANDROID_ABIS": "arm64-v8a",
        "ANDROID_OPTIMIZE": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "ANDROID_ABIS": "arm64-v8a",
        "ANDROID_OPTIMIZE": "1"
      }
    }
  }
}
